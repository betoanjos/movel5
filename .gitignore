# Nunca versionar dados financeiros reais.
# Extratos, comprovantes e relatórios são material sensível da empresa —
# o painel lê tudo dentro do navegador, então nada disso precisa estar aqui.
*.ofx
*.ofc
*.qfx
*.xlsx
*.xls
*.xlsm
*.csv
*.pdf
!docs/**/*.pdf
/web/amostras/
/dados/
/amostras/

# Backups exportados pelo painel
movel5-backup-*.json

# Node e Wrangler
node_modules/
.wrangler/
.dev.vars
# Pacotes gerados por scripts/bundle.mjs ficam de fora, menos os dois do
# Worker publicado: eles são o artefato de publicação e o meio de levá-lo
# até a API da Cloudflare.
dist/
!worker/dist/
!worker/dist/*.js
!web/dist/
!web/dist/*.js
!web/dist/*.md

# Sistema operacional e editores
.DS_Store
Thumbs.db
*.swp
.idea/
.vscode/
